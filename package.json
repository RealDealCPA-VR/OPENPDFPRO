{
  "name": "openpdfpro",
  "productName": "Open PDF Pro",
  "version": "0.1.0",
  "description": "Open-source local-only desktop PDF editor (Acrobat Pro feature parity, clean-room)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "build": {
    "appId": "com.openpdfpro.app",
    "productName": "Open PDF Pro",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "publish": { "provider": "github", "owner": "RealDealCPA-VR", "repo": "OPENPDFPRO" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "tesseract.js": "^7.0.0"
  }
}
